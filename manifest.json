{
  "manifest_version": 3,
  "name": "Arctic: Sidebar & Commands",
  "short_name": "Arctic",
  "version": "2.0.0",
  "description": "Vertical tab sidebar, spaces, and lightning-fast command bar.",
  "key": "",
  "permissions": [
    "sidePanel",
    "bookmarks",
    "tabs",
    "storage",
    "favicon",
    "history",
    "alarms",
    "notifications",
    "sessions",
    "search",
    "scripting"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S",
        "chromeos": "Ctrl+Shift+Y"
      },
      "description": "Toggle Arctic Sidebar"
    }
  },
  "action": {
    "default_title": "Open Arctic",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
