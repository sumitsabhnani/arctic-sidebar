{
  "manifest_version": 3,
  "name": "Arctic: Sidebar & Commands",
  "short_name": "Arctic",
  "version": "1.6.8",
  "description": "Vertical bookmark sidebar, spaces, and lightning-fast command bar.",
  "permissions": [
    "sidePanel",
    "bookmarks",
    "tabs",
    "storage",
    "favicon",
    "history",
    "alarms",
    "notifications",
    "sessions"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Arctic",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
